# Frontend (copy to nextjs-keyconcepts/.env.local)
NEXT_PUBLIC_API_BASE_URL=https://api.keyconcepts.co.in/api
NEXT_PUBLIC_SITE_URL=https://v2.keyconcepts.co.in

# Backend (copy to backend/.env on the API server)
# Comma-separated extra origins if needed (v2 + main site are already allowed in code)
CORS_ORIGINS=https://v2.keyconcepts.co.in
